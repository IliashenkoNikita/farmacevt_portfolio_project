{
  "name": "holos-kyivshchyny-bpr-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "tsx tools/check-finished.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility-home.spec.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "env:check": "tsx tools/env-check.ts",
    "security:scan": "pnpm audit --audit-level high && pnpm lint",
    "lighthouse": "tsx tools/lighthouse-command.ts",
    "seed": "tsx prisma/seed.ts",
    "ci:all": "pnpm lint && pnpm typecheck && pnpm prisma:validate && pnpm env:check && pnpm test && pnpm build",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.2.0",
    "@prisma/client": "^6.10.0",
    "@tailwindcss/postcss": "^4.1.0",
    "better-auth": "^1.6.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "gsap": "^3.13.0",
    "next": "latest",
    "nodemailer": "^7.0.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^7.3.0",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "^7.58.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.53.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "latest",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "prisma": "^6.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
